<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <ul>
        <% for(let i=0;i<messages.length;i++) { %>
            <li>
                <h2><%=messages[i].user%></h2>
                <p><%=messages[i].text%></p>
                <p>Date added :<%=messages[i].added%> </p>
            </li>
        <% } %>
    </ul>
</body>
</html>